{{ 'xfe-password.css' | asset_url | stylesheet_tag }}

<div class="xfe-password">
  <div class="xfe-password__card" {{ section.shopify_attributes }}>
    <span class="xfe-password__eyebrow">Acceso anticipado</span>

    <p class="xfe-password__logo">
      <span class="xfe-logo__bracket">[</span>{{ shop.name }}<span class="xfe-logo__bracket">]</span>
    </p>

    <p class="xfe-password__message">
      {%- if shop.password_message != blank -%}
        {{ shop.password_message }}
      {%- else -%}
        {{ section.settings.message }}
      {%- endif -%}
    </p>

    {%- form 'storefront_password', class: 'xfe-password__form' -%}
      {%- if form.errors -%}
        <p class="xfe-password__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label for="Password" class="xfe-visually-hidden">Contraseña</label>
      <input
        type="password"
        name="password"
        id="Password"
        class="xfe-password__input"
        placeholder="Contraseña"
        autocomplete="current-password"
        autofocus
      >

      <button type="submit" class="xfe-btn xfe-btn--primary">
        Entrar
        <span class="xfe-btn__arrow" aria-hidden="true">&rarr;</span>
      </button>
    {%- endform -%}

    <div class="xfe-password__footer">
      {%- if section.settings.show_social and shop.email != blank -%}
        <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
      {%- endif -%}
      <a href="{{ shop.url }}/admin">Iniciar sesión como administrador</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "XFE Password",
  "tag": "section",
  "class": "xfe-password-section",
  "settings": [
    {
      "type": "textarea",
      "id": "message",
      "label": "Mensaje",
      "default": "Estamos construyendo algo diferente. Built for those who move different.",
      "info": "Se muestra solo si no hay un mensaje configurado en Preferencias de la tienda."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Mostrar correo de contacto",
      "default": true
    }
  ]
}
{% endschema %}
