{{ 'xfe-page.css' | asset_url | stylesheet_tag }}

<section class="xfe-page-hero" {{ section.shopify_attributes }}>
  <div class="xfe-container">
    {%- if section.settings.eyebrow != blank -%}
      <span class="xfe-page-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="xfe-page-hero__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="xfe-page-hero__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
    {%- if section.settings.meta != blank -%}
      <p class="xfe-page-hero__meta">{{ section.settings.meta }}</p>
    {%- endif -%}
  </div>
</section>

<section class="xfe-container xfe-page-body">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'block' -%}
          <article class="xfe-page-block" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="xfe-page-block__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="xfe-page-block__content">{{ block.settings.content }}</div>
          </article>
      {%- endcase -%}
    {%- endfor -%}
  {%- elsif page.content != blank -%}
    <article class="xfe-page-block">
      <div class="xfe-page-block__content">{{ page.content }}</div>
    </article>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "XFE Page",
  "tag": "section",
  "class": "xfe-page-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Si se deja vacío, usa el título de la página."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Texto secundario",
      "info": "Ej. \"Última actualización: enero de 2026\""
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Bloque de contenido",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XFE Page"
    }
  ]
}
{% endschema %}
