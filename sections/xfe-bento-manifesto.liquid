{{ 'xfe-bento.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}" class="xfe-bento xfe-container" {{ section.shopify_attributes }}>
  <div class="xfe-bento__header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="xfe-bento__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="xfe-bento__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="xfe-bento__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'pillar' -%}
            <article
              class="xfe-bento-card"
              data-xfe-bento-card
              {{ block.shopify_attributes }}
            >
              <span class="xfe-bento-card__index">0{{ forloop.index }}</span>

              <span class="xfe-bento-card__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'identity' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8" r="3.25"></circle>
                      <path d="M5.5 20c1.2-3.4 4-5 6.5-5s5.3 1.6 6.5 5"></path>
                    </svg>
                  {%- when 'excellence' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3.5l2.47 5.13 5.53.62-4.12 3.87 1.1 5.63L12 15.9l-4.98 2.85 1.1-5.63-4.12-3.87 5.53-.62L12 3.5z"></path>
                    </svg>
                  {%- when 'faith' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 21c4-2.4 6-5.4 6-9 0-3-2-6.5-4-8 .3 2-.4 3.6-1.6 4.6C11 9.6 10 7.5 10.4 5 8 7 6 10 6 12.5c0 3.6 2 6.1 6 8.5z"></path>
                    </svg>
                  {%- when 'authenticity' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3l7 3v5c0 4.5-3 7.7-7 10-4-2.3-7-5.5-7-10V6l7-3z"></path>
                      <path d="M9 12.2l2 2 4-4.2"></path>
                    </svg>
                  {%- when 'community' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="7" cy="8" r="2.25"></circle>
                      <circle cx="17" cy="8" r="2.25"></circle>
                      <circle cx="12" cy="16.5" r="2.25"></circle>
                      <path d="M7 10.25c-1.8.6-3 2-3 4.25M17 10.25c1.8.6 3 2 3 4.25M9.6 15.1L10.6 14M14.4 15.1l-1-1.1"></path>
                    </svg>
                {%- endcase -%}
              </span>

              <h3 class="xfe-bento-card__title">{{ block.settings.heading }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="xfe-bento-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script src="{{ 'xfe-bento.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "XFE Bento Manifesto",
  "tag": "section",
  "class": "xfe-bento-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "El manifiesto"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Cinco pilares. Un solo movimiento."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "identity", "label": "Identidad" },
            { "value": "excellence", "label": "Excelencia" },
            { "value": "faith", "label": "Fe" },
            { "value": "authenticity", "label": "Autenticidad" },
            { "value": "community", "label": "Comunidad" }
          ],
          "default": "identity"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Identidad"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Sabemos quiénes somos y lo mostramos sin pedir permiso."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "pillar",
        "settings": {
          "icon": "identity",
          "heading": "Identidad",
          "text": "Sabemos quiénes somos y lo mostramos sin pedir permiso."
        }
      },
      {
        "type": "pillar",
        "settings": {
          "icon": "excellence",
          "heading": "Excelencia",
          "text": "Cada prenda se construye con el mismo rigor que un producto bien diseñado."
        }
      },
      {
        "type": "pillar",
        "settings": {
          "icon": "faith",
          "heading": "Fe",
          "text": "Movemos distinto porque creemos en algo más grande que la tendencia."
        }
      },
      {
        "type": "pillar",
        "settings": {
          "icon": "authenticity",
          "heading": "Autenticidad",
          "text": "Sin atajos ni copias. Lo real se nota en los detalles."
        }
      },
      {
        "type": "pillar",
        "settings": {
          "icon": "community",
          "heading": "Comunidad",
          "text": "Construimos con la gente que se mueve con nosotros, no para ella."
        }
      }
    ]
  },
  "presets": [
    {
      "name": "XFE Bento Manifesto",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "identity", "heading": "Identidad", "text": "Sabemos quiénes somos y lo mostramos sin pedir permiso." } },
        { "type": "pillar", "settings": { "icon": "excellence", "heading": "Excelencia", "text": "Cada prenda se construye con el mismo rigor que un producto bien diseñado." } },
        { "type": "pillar", "settings": { "icon": "faith", "heading": "Fe", "text": "Movemos distinto porque creemos en algo más grande que la tendencia." } },
        { "type": "pillar", "settings": { "icon": "authenticity", "heading": "Autenticidad", "text": "Sin atajos ni copias. Lo real se nota en los detalles." } },
        { "type": "pillar", "settings": { "icon": "community", "heading": "Comunidad", "text": "Construimos con la gente que se mueve con nosotros, no para ella." } }
      ]
    }
  ]
}
{% endschema %}
