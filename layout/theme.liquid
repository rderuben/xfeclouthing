<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#050505">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ content_for_header }}

    <style>
      /* Critical CSS: evita el flash de fondo blanco antes de cargar la hoja de estilos completa. */
      html, body {
        background-color: #050505;
        color: #f4f4f4;
      }
      body {
        font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }
    </style>

    {{ 'xfe-base.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="xfe-body">
    <a class="xfe-skip-link" href="#MainContent">
      Saltar al contenido
    </a>

    {% section 'xfe-header' %}

    <main id="MainContent" class="xfe-main">
      {{ content_for_layout }}
    </main>

    {% section 'xfe-footer' %}
  </body>
</html>
